# Commercial game data must never be committed.
__ROM__/
rom/
*.32x
*.32X
*.bin
*.gen
*.smd

# Code generated from the user's ROM (derived from copyrighted data)
generated/*
!generated/README.md

# Build outputs
build*/
out/
analysis_out/

# Runtime output
*.png
# ...except the app icon (THIRD_PARTY.md), which is not runtime output
!assets/icon/*.png
!platforms/android/app/src/main/res/mipmap-*/ic_launcher.png
# ...and the screenshots that docs and issue replies link to
!docs/images/*.png
*.ppm
*.wav
*.trace
*.srm
saves/

# Android: machine-specific SDK location and Gradle state
platforms/android/local.properties
# Signing keystore paths and passwords, if you build a signed release APK.
platforms/android/gradle.properties
*.keystore
*.jks
platforms/android/.gradle/
platforms/android/build/
platforms/android/app/build/
platforms/android/app/.cxx/
platforms/android/**/.cxx/
.gradle/

# IDE
.vs/
.vscode/
.idea/
