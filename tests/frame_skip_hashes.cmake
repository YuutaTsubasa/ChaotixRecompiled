# Frame skip (issue #62) leaves the game alone: the same run with and without
# --frame-skip prints the same fingerprints of the machine without its
# picture (gamehash, every frame) and the same picture hashes on the frames
# hashed (hash, which are always drawn; the frames between them are not).
#   cmake -DHEADLESS=... -DROM=... -DSKIP=N -DARGS="a|b|..." -P frame_skip_hashes.cmake
string(REPLACE "|" ";" ARGS "${ARGS}")
foreach(run plain skipped)
    set(extra)
    if(run STREQUAL "skipped")
        set(extra --frame-skip ${SKIP})
    endif()
    execute_process(COMMAND "${HEADLESS}" --rom "${ROM}" ${ARGS} --game-hash-every 1 --hash-every 30 ${extra}
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${run} run failed (${rc}):\n${out}")
    endif()
    string(REGEX MATCHALL "(game)?hash [0-9]+ [0-9a-f]+" ${run}_hashes "${out}")
    if(run STREQUAL "skipped")
        string(REGEX MATCH "frame skip: [0-9]+ frames drawn, [0-9]+ skipped" summary "${out}")
    endif()
endforeach()
list(LENGTH plain_hashes n)
if(n LESS 100)
    message(FATAL_ERROR "only ${n} hashes printed")
endif()
list(LENGTH skipped_hashes m)
if(NOT n EQUAL m)
    message(FATAL_ERROR "${n} hashes without skipping, ${m} with")
endif()
if(NOT plain_hashes STREQUAL skipped_hashes)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
        list(GET plain_hashes ${i} a)
        list(GET skipped_hashes ${i} b)
        if(NOT a STREQUAL b)
            message(FATAL_ERROR "differs with --frame-skip ${SKIP}: ${a} vs ${b}")
        endif()
    endforeach()
    message(FATAL_ERROR "differs with --frame-skip ${SKIP}")
endif()
message("frame skip: ${n} hashes identical; ${summary}")
